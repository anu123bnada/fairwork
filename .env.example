# Optional until connecting Auth. Leave empty for the unconfigured foundation page.
# Browser-safe project connection data; never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only canonical origin for same-origin mutations. Use HTTPS when hosted.
APP_ORIGIN=http://localhost:3000
# Day 1 supports synthetic competition data only.
FAIRWORK_DATA_MODE=synthetic

# Disabled until hosted signup, confirmation email delivery/template and origin
# have been explicitly approved and configured. Does not grant employer authority.
AUTH_REGISTRATION_ENABLED=false

# Server-only optional AI. Keep disabled pending documented owner approval of
# the actual provider product/account, processing region and retention terms.
# A region label does not configure regional routing. See docs/GEMINI_PROCESSING_GATE.md.
ORYQEN_AI_PROVIDER=gemini
ORYQEN_AI_ENABLED=false
ORYQEN_AI_POLICY_APPROVED=false
ORYQEN_AI_POLICY_APPROVAL_REF=
ORYQEN_AI_PROCESSING_REGION=
ORYQEN_AI_DATA_USE=
GEMINI_MODEL=
GEMINI_API_KEY=

# No service-role, DB owner, real AI keys or passwords belong in this example.
# Configure secrets only in an ignored local environment or approved secret store;
# never prefix an AI credential with NEXT_PUBLIC_.

# Optional server-only append-only telemetry connection using the restricted
# oryqen_telemetry_writer role. Never use a database owner or API service role.
# Local launcher provisions/injects this separately; leave this example empty.
ORYQEN_TELEMETRY_DB_URL=
