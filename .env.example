# Optional until connecting Auth. Leave empty for the unconfigured foundation page.
# Browser-safe project connection data; never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only canonical origin for same-origin mutations. Use HTTPS when hosted.
APP_ORIGIN=http://localhost:3000
# Use supabase for hosted real-data deployments; synthetic is the local default.
FAIRWORK_DATA_MODE=synthetic

# Disabled until hosted signup, confirmation email delivery/template and origin
# have been explicitly approved and configured. Does not grant employer authority.
AUTH_REGISTRATION_ENABLED=false

# Server-only optional AI. Keep disabled pending documented owner approval of
# the actual provider product/account, processing region and retention terms.
# A region label does not configure regional routing. See docs/GEMINI_PROCESSING_GATE.md.
ORYQEN_AI_PROVIDER=gemini
ORYQEN_AI_ENABLED=false
ORYQEN_AI_POLICY_APPROVED=false
ORYQEN_AI_POLICY_APPROVAL_REF=
ORYQEN_AI_PROCESSING_REGION=
ORYQEN_AI_DATA_USE=
GEMINI_MODEL=
GEMINI_API_KEY=

# Optional AI gateway fallbacks (docs/ORYQEN_AI_GATEWAY.md). Leave empty to keep a single provider. A fallback is used only when it is
# listed here, is approved in writing on its OWN settings below, and the person's consent names it. The unsuffixed approval above
# belongs to the primary provider only.
ORYQEN_AI_FALLBACK_PROVIDERS=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ORYQEN_AI_OPENAI_POLICY_APPROVAL_REF=
# ORYQEN_AI_OPENAI_PROCESSING_REGION=
# ORYQEN_AI_OPENAI_DATA_USE=
# A self-hosted OpenAI-compatible server (https, or http on loopback for local testing):
# ORYQEN_SELFHOSTED_AI_URL=
# ORYQEN_SELFHOSTED_AI_MODEL=
# ORYQEN_SELFHOSTED_AI_KEY=
# ORYQEN_AI_SELFHOSTED_POLICY_APPROVAL_REF=
# ORYQEN_AI_SELFHOSTED_PROCESSING_REGION=
# ORYQEN_AI_SELFHOSTED_DATA_USE=
# Optional daily budgets per provider (requests, tokens); a provider over budget is skipped without any request being sent:
# ORYQEN_AI_GEMINI_DAILY_REQUESTS=
# ORYQEN_AI_GEMINI_DAILY_TOKENS=

# No service-role, DB owner, real AI keys or passwords belong in this example.
# Configure secrets only in an ignored local environment or approved secret store;
# never prefix an AI credential with NEXT_PUBLIC_.

# Optional server-only append-only telemetry connection using the restricted
# oryqen_telemetry_writer role. Never use a database owner or API service role.
# Local launcher provisions/injects this separately; leave this example empty.
ORYQEN_TELEMETRY_DB_URL=

# Public download links. Leave empty until an approved HTTPS release host exists;
# the landing page and /downloads keep their controls disabled until each is a valid
# https URL. Release facts (size, checksum, signing) live in src/features/releases.
NEXT_PUBLIC_WINDOWS_URL=
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Verifiable credentials (owner-held key). Leave empty until the owner has run
# scripts/generate-credential-key.mjs and stored the private key offline. Without all of
# these the app cannot issue credentials and says so; there is no fallback key.
# ORYQEN_CREDENTIAL_SIGNING_KEY is the single-line JSON private JWK (server-only secret).
ORYQEN_CREDENTIAL_KEY_ID=
ORYQEN_CREDENTIAL_SIGNING_KEY=
ORYQEN_CREDENTIAL_PUBLIC_KEYS=
