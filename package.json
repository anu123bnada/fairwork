{
  "name": "fairwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:live:gemini": "vitest run --config vitest.live.config.ts tests/live/gemini-synthetic.live.ts",
    "test:live:research": "vitest run --config vitest.live.config.ts tests/live/gleif-research.live.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node scripts/test-browser.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:verify:full": "node scripts/release-verify.mjs --full",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema api > src/types/database.generated.ts"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.6",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/space-grotesk": "5.2.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tesseract.js-data/eng": "1.0.0",
    "framer-motion": "12.23.24",
    "jose": "6.2.13",
    "lucide-react": "0.468.0",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "next": "16.4.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tesseract.js": "7.0.0",
    "three": "0.180.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "supabase": "2.120.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
